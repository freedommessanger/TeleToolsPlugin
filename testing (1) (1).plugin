def _make_svg_bitmap(svg_path_str: str, argb_color: int, dp_size: int):
    try:
        from android.graphics import Bitmap, Canvas, Paint, Path, PorterDuff
        ctx     = ApplicationLoader.applicationContext
        density = ctx.getResources().getDisplayMetrics().density
        sz      = max(int(dp_size * density), 8)
        bmp = Bitmap.createBitmap(sz, sz, Bitmap.Config.ARGB_8888)
        cv  = Canvas(bmp)
        cv.drawColor(0, PorterDuff.Mode.CLEAR)
        scale = sz / 24.0
        cv.scale(scale, scale)
        path  = Path()
        paint = Paint()
        paint.setAntiAlias(True)
        paint.setColor(argb_color)
        paint.setStyle(Paint.Style.FILL_AND_STROKE)
        paint.setStrokeWidth(0.8)
        paint.setStrokeCap(Paint.Cap.ROUND)
        paint.setStrokeJoin(Paint.Join.ROUND)
        _parse_svg_path(path, svg_path_str)
        cv.drawPath(path, paint)
        return bmp
    except Exception:
        return None


def _parse_svg_path(path, d: str):
    from android.graphics import RectF
    import re
    tokens = re.findall(r"[MmLlZzAaCcQqHhVvSsTt]|[-+]?[0-9]*\.?[0-9]+", d)
    i = 0
    cmd = "M"
    cx, cy = 0.0, 0.0

    def nf():
        nonlocal i
        v = float(tokens[i]); i += 1; return v

    while i < len(tokens):
        t = tokens[i]
        if t.isalpha():
            cmd = t; i += 1; continue
        if cmd == "M":
            x, y = nf(), nf(); path.moveTo(x, y); cx, cy = x, y; cmd = "L"
        elif cmd == "m":
            x, y = cx+nf(), cy+nf(); path.moveTo(x, y); cx, cy = x, y; cmd = "l"
        elif cmd == "L":
            x, y = nf(), nf(); path.lineTo(x, y); cx, cy = x, y
        elif cmd == "l":
            x, y = cx+nf(), cy+nf(); path.lineTo(x, y); cx, cy = x, y
        elif cmd in ("Z", "z"):
            path.close()
        elif cmd == "H":
            x = nf(); path.lineTo(x, cy); cx = x
        elif cmd == "h":
            x = cx+nf(); path.lineTo(x, cy); cx = x
        elif cmd == "V":
            y = nf(); path.lineTo(cx, y); cy = y
        elif cmd == "v":
            y = cy+nf(); path.lineTo(cx, y); cy = y
        elif cmd == "C":
            x1,y1,x2,y2,x,y = nf(),nf(),nf(),nf(),nf(),nf()
            path.cubicTo(x1,y1,x2,y2,x,y); cx,cy = x,y
        elif cmd == "c":
            x1,y1 = cx+nf(),cy+nf(); x2,y2 = cx+nf(),cy+nf(); x,y = cx+nf(),cy+nf()
            path.cubicTo(x1,y1,x2,y2,x,y); cx,cy = x,y
        elif cmd == "Q":
            x1,y1,x,y = nf(),nf(),nf(),nf(); path.quadTo(x1,y1,x,y); cx,cy = x,y
        elif cmd == "q":
            x1,y1 = cx+nf(),cy+nf(); x,y = cx+nf(),cy+nf()
            path.quadTo(x1,y1,x,y); cx,cy = x,y
        elif cmd == "A":
            rx,ry,rot,la,sw,x,y = nf(),nf(),nf(),nf(),nf(),nf(),nf()
            _arc_to(path, cx, cy, rx, ry, rot, int(la), int(sw), x, y); cx,cy = x,y
        elif cmd == "a":
            rx,ry,rot,la,sw = nf(),nf(),nf(),nf(),nf(); x,y = cx+nf(), cy+nf()
            _arc_to(path, cx, cy, rx, ry, rot, int(la), int(sw), x, y); cx,cy = x,y
        else:
            i += 1


def _arc_to(path, x1, y1, rx, ry, phi, fa, fs, x2, y2):
    import math
    from android.graphics import RectF
    if rx == 0 or ry == 0:
        path.lineTo(x2, y2); return
    phi_r = math.radians(phi)
    cos_p, sin_p = math.cos(phi_r), math.sin(phi_r)
    dx, dy = (x1-x2)/2.0, (y1-y2)/2.0
    x1p =  cos_p*dx + sin_p*dy
    y1p = -sin_p*dx + cos_p*dy
    r = (x1p*x1p)/(rx*rx) + (y1p*y1p)/(ry*ry)
    if r > 1:
        sq = math.sqrt(r); rx *= sq; ry *= sq
    num = max(0.0, rx*rx*ry*ry - rx*rx*y1p*y1p - ry*ry*x1p*x1p)
    den = rx*rx*y1p*y1p + ry*ry*x1p*x1p
    sq  = math.sqrt(num/den) if den else 0
    if fa == fs: sq = -sq
    cxp =  sq*rx*y1p/ry
    cyp = -sq*ry*x1p/rx
    cx = cos_p*cxp - sin_p*cyp + (x1+x2)/2.0
    cy = sin_p*cxp + cos_p*cyp + (y1+y2)/2.0

    def ang(ux, uy, vx, vy):
        n = math.sqrt(ux*ux+uy*uy)*math.sqrt(vx*vx+vy*vy)
        if n == 0: return 0
        c = max(-1, min(1, (ux*vx+uy*vy)/n))
        a = math.degrees(math.acos(c))
        return -a if (ux*vy-uy*vx)<0 else a

    theta  = ang(1, 0, (x1p-cxp)/rx, (y1p-cyp)/ry)
    dtheta = ang((x1p-cxp)/rx, (y1p-cyp)/ry, (-x1p-cxp)/rx, (-y1p-cyp)/ry)
    if fs == 0 and dtheta > 0: dtheta -= 360
    if fs == 1 and dtheta < 0: dtheta += 360
    rect = RectF(cx-rx, cy-ry, cx+rx, cy+ry)
    path.arcTo(rect, theta, dtheta)


