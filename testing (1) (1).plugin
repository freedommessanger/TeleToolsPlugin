def _make_eye_bitmap(rgb: tuple, dp_size: int):
    from android.graphics import Bitmap, Canvas, Paint, Path, PorterDuff
    ctx     = ApplicationLoader.applicationContext
    density = ctx.getResources().getDisplayMetrics().density
    h       = max(int(dp_size * density), 8)
    w       = max(int(dp_size * density * 2.2), 16)
    r, g, b = rgb
    bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
    cv  = Canvas(bmp)
    cv.drawColor(0, PorterDuff.Mode.CLEAR)
    cx = w / 2.0; cy = h / 2.0
    pad = h * 0.10; lx = pad; rx = w - pad
    ew = rx - lx; eh = h * 0.48
    eye_path = Path()
    eye_path.moveTo(lx, cy)
    eye_path.cubicTo(lx+ew*0.18, cy-eh, rx-ew*0.18, cy-eh, rx, cy)
    eye_path.cubicTo(rx-ew*0.18, cy+eh*0.72, lx+ew*0.18, cy+eh*0.72, lx, cy)
    eye_path.close()
    cv.save()
    cv.clipPath(eye_path)
    p = Paint(); p.setAntiAlias(True); p.setStyle(Paint.Style.FILL)
    p.setARGB(255, 252, 252, 255); cv.drawRect(0.0, 0.0, float(w), float(h), p)
    iris_r = eh * 0.90
    p.setARGB(255, r, g, b); cv.drawCircle(cx, cy, iris_r, p)
    pupil_r = iris_r * 0.44
    p.setARGB(255, 15, 15, 22); cv.drawCircle(cx, cy, pupil_r, p)
    p.setARGB(220, 255, 255, 255)
    cv.drawCircle(cx+pupil_r*0.32, cy-pupil_r*0.32, pupil_r*0.32, p)
    cv.restore()
    sw = Paint(); sw.setAntiAlias(True)
    sw.setARGB(230, max(r-50,0), max(g-50,0), max(b-50,0))
    sw.setStyle(Paint.Style.STROKE); sw.setStrokeWidth(h*0.07)
    sw.setStrokeCap(Paint.Cap.ROUND); sw.setStrokeJoin(Paint.Join.ROUND)
    cv.drawPath(eye_path, sw)
    return bmp


